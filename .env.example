# ============================================================================
# .env.example — TEMPLATE env umpomenfess-form (aman dikommit; isinya contoh)
# CARA PAKAI:
#   1. cp .env.example .env.local
#   2. Isi .env.local dengan nilai ASLI (jangan pernah dikommit)
#   3. Tempel nilai yang sama ke Vercel: Project → Settings → Environment Variables
#      (set Production + Preview)
# Punya pertanyaan? Lihat TASK.md bagian 4.1 (daftar env resmi).
# ============================================================================

# --- URL site ---------------------------------------------------------------
# Dipakai untuk metadata build (astro.config.mjs). Untuk dev lokal tidak krusial.
# Contoh : https://form.umpomenfess.my.id
# Cara   : domain sendiri (sudah dijurumakan di Vercel/DNS).
PUBLIC_SITE_URL=https://form.umpomenfess.my.id

# --- Supabase (project BARU khusus form; bukan punya situs menfess!) ---------
# Buka : dashboard.supabase.com → pilih project → Project Settings → API
# Copas:  • Project URL            → PUBLIC_SUPABASE_URL
#         • Key "publishable"/"anon" (BUKAN secret) → PUBLIC_SUPABASE_ANON_KEY
#         • Key "secret"/"service_role"             → SUPABASE_SERVICE_ROLE_KEY
# Format contoh (dua-duanya sah):
#   PUBLIC_SUPABASE_URL=https://abcdefghijk.supabase.co
#   PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
#   SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# (format lama berupa JWT yang diawali "eyJ..." juga sah)
# PENTING: SUPABASE_SERVICE_ROLE_KEY = kunci master (bypass RLS).
#          Hanya di server. JANGAN pakai prefix PUBLIC_, jangan ke client.
#          RLS aktif di T-11; setelah isi env, jalankan migrasi (lihat
#          supabase/migrations/*.sql — via `supabase db push` atau SQL Editor).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudinary (akun BARU khusus form) -------------------------------------
# Buka : console.cloudinary.com — Cloud name tertera di halaman utama (Dashboard).
# Key  : Settings → Access Keys → API Keys → API Key dan API Secret
# Format contoh:
#   CLOUDINARY_CLOUD_NAME=umpomenfess-form
#   CLOUDINARY_API_KEY=123456789012345
#   CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx
# PENTING: CLOUDINARY_API_SECRET hanya di server (dipakai endpoint /api/uploads/sign
#          milik Agent B/D). Jangan pernah sampai ke browser.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudflare Turnstile (anti-spam) ---------------------------------------
# Buka : dash.cloudflare.com → Turnstile → Add site
#        (isikan domain form.umpomenfess.my.id + localhost untuk dev)
# Copas: Site Key → TURNSTILE_SITE_KEY ; Secret Key → TURNSTILE_SECRET_KEY
# Format contoh:
#   TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxx
#   TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxlXXXX
# CATATAN KONTRAK: nama di sini sesuai TASK 4.1 (TANPA prefix PUBLIC_).
# Site key dikirim ke browser lewat prop dari server saat render (bukan secret).
# Secret key hanya dipakai endpoint submit (Agent C) di server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Ops backup (Agent D, T-61) ---------------------------------------------
# SUPABASE_DB_URL: connection string Postgres utk pg_dump (workflow backup
#          mingguan, scripts/backup.mjs + GitHub Actions). Buka:
#          dashboard.supabase.com → Project Settings → Database → Connection
#          string (sisi server/workflow — JANGAN dikommit / ke client).
# BACKUP_BUCKET: nama bucket Supabase Storage PRIVAT tujuan backup
#          (opsional; default 'db-backups' di scripts/backup.mjs).
#          Bucket WAJIB privat — backup publik ditolak script (T-61).
SUPABASE_DB_URL=
BACKUP_BUCKET=
