---
import '../styles/global.css';
import themeInitUrl from '../styles/theme-init.js?url&no-inline';
import themeToggleUrl from '../styles/theme-toggle.js?url&no-inline';
import navMenuUrl from '../styles/nav-menu.js?url&no-inline';
import respondentThemeInitUrl from '../scripts/respondent-theme-init.js?url&no-inline';
import respondentThemeUrl from '../scripts/respondent-theme.js?url&no-inline';

interface Props {
  title?: string;
  description?: string;
  /** false = chrome responden: tanpa header navigasi & footer situs (halaman isi form). */
  nav?: boolean;
  footer?: boolean;
}
const {
  title = 'umpomenfess form',
  description = 'Form builder untuk civitas UMPO: susun pertanyaan, pilih tampilan, sebar satu tautan, baca jawaban di dashboard.',
  nav = true,
  footer = true,
} = Astro.props;
const main = 'https://umpomenfess.my.id';
// true bila pengunjung mempunyai sesi (diisi middleware.ts); false = tamu
const user = Astro.locals.user;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#FDEEEC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131C1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FDEEEC" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="umpomenfess form" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23FDEEEC'/%3E%3Crect x='6' y='5' width='20' height='22' rx='6' fill='%23E8604C'/%3E%3Cpath d='M11 12h10M11 16h10M11 20h6' stroke='%23FFF6EA' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='26' cy='6' r='3' fill='%23F6C96B'/%3E%3C/svg%3E"
    />

    <script is:inline src={nav ? themeInitUrl : respondentThemeInitUrl}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&amp;family=Quicksand:wght@400;500;600;700&amp;family=Space+Mono:wght@700&amp;display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Lompat ke konten</a>
    <div class="bg-blobs" aria-hidden="true"></div>

    {nav && (
      <header class="site-header">
      <div class="site-header__row">
        <a class="brand" href="/" aria-label="umpomenfess form — beranda">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="4.5" y="3" width="15" height="18" rx="3" />
              <path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4" />
              <circle cx="18.5" cy="5.5" r="2.6" fill="#F6C96B" stroke="none" />
            </svg>
          </span>
          <span class="brand__name">umpomenfess</span>
          <span class="brand__divider" aria-hidden="true"></span>
          <span class="brand__sub">form</span>
        </a>

        <div class="site-header__actions">
          <nav class="site-nav" aria-label="Navigasi utama">
            <a href="/#cara">Cara kerja</a>
            <a href="/#tema">Tema</a>
            <a href={main} aria-label="Menfess, situs utama">Menfess ↗</a>
            {!user && <a href="/login">Masuk</a>}
          </nav>
          {user ? (
            <a class="nav-cta" href="/dashboard">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="2" />
                <rect x="14" y="3" width="7" height="7" rx="2" />
                <rect x="3" y="14" width="7" height="7" rx="2" />
                <rect x="14" y="14" width="7" height="7" rx="2" />
              </svg>
              Dashboard
            </a>
          ) : (
            <a class="nav-cta" href="/login?tab=signup">Daftar</a>
          )}
          <button
            class="theme-toggle"
            type="button"
            data-theme-toggle
            aria-label="Aktifkan tema gelap"
            aria-pressed="false"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2v2.4M12 19.6V22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M2 12h2.4M19.6 12H22M4.9 19.1l1.7-1.7M17.4 6.6l1.7-1.7" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20.3 14.2A8.4 8.4 0 0 1 9.8 3.7a8.5 8.5 0 1 0 10.5 10.5z" />
            </svg>
          </button>
          <details class="nav-mobile" data-nav-menu>
            <summary class="menu-button" aria-label="Buka menu">
              <span></span>
              <span></span>
            </summary>
            <nav class="mobile-menu" aria-label="Navigasi mobile">
              <a href="/#cara">Cara kerja</a>
              <a href="/#tema">Tema</a>
              {user ? (
                <a href="/dashboard">Dashboard</a>
              ) : (
                <>
                  <a href="/login">Masuk</a>
                  <a href="/login?tab=signup">Daftar</a>
                </>
              )}
              <a href={main} aria-label="Menfess, situs utama">Menfess ↗</a>
            </nav>
          </details>
        </div>
      </div>
      </header>
    )}

    {!nav && (
      <header class="respondent-topbar">
        <div class="respondent-topbar__inner">
          <div class="respondent-wm__chip" aria-hidden="true">
            <span class="brand__mark">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4.5" y="3" width="15" height="18" rx="3" />
                <path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4" />
                <circle cx="18.5" cy="5.5" r="2.6" fill="#F6C96B" stroke="none" />
              </svg>
            </span>
            <span class="brand__name">umpomenfess</span>
            <span class="brand__divider" aria-hidden="true"></span>
            <span class="brand__sub">form</span>
          </div>

          <button
            type="button"
            class="respondent-theme-toggle"
            id="respondent-theme-toggle"
            aria-label="Ganti tema gelap atau terang"
            title="Ganti tema gelap / terang"
          >
            <svg class="icon-sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5" />
              <line x1="12" y1="1" x2="12" y2="3" />
              <line x1="12" y1="21" x2="12" y2="23" />
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
              <line x1="1" y1="12" x2="3" y2="12" />
              <line x1="21" y1="12" x2="23" y2="12" />
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            </svg>
          </button>
        </div>
      </header>
    )}

    <main id="main" class:list={[{ 'main--respondent': !nav }]}><slot /></main>

    {footer && (
      <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <a class="brand" href="/" aria-label="umpomenfess form — beranda">
            <span class="brand__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4.5" y="3" width="15" height="18" rx="3" />
                <path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4" />
                <circle cx="18.5" cy="5.5" r="2.6" fill="#F6C96B" stroke="none" />
              </svg>
            </span>
            <span class="brand__name">umpomenfess</span>
            <span class="brand__divider" aria-hidden="true"></span>
            <span class="brand__sub">form</span>
          </a>
          <p>Form builder untuk civitas UMPO. Susun pertanyaan, sebar tautan, baca jawaban di dashboard.</p>
        </div>
        <nav class="site-footer__links" aria-label="Navigasi footer">
          <a href="/#cara">Cara kerja</a>
          <a href="/#tema">Tema</a>
          {user ? <a href="/dashboard">Dashboard</a> : <a href="/login">Masuk</a>}
          <a href="/terms">Ketentuan Layanan</a>
          <a href={main} aria-label="Menfess, situs utama">Menfess ↗</a>
        </nav>
      </div>
      <div class="site-footer__bottom">© 2026 umpomenfess · Universitas Muhammadiyah Ponorogo</div>
      </footer>
    )}

    <script is:inline src={nav ? themeToggleUrl : respondentThemeUrl}></script>
    {nav && <script is:inline src={navMenuUrl}></script>}

    <style>
      .main--respondent {
        padding-top: 0;
        min-height: auto;
      }
      .respondent-topbar {
        position: static;
        width: 100%;
        padding-top: max(var(--space-3), env(safe-area-inset-top, 0px));
        padding-bottom: var(--space-1);
        padding-inline: 16px;
      }
      .respondent-topbar__inner {
        max-width: 640px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
      }
      .respondent-wm__chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 14px 5px 10px;
        border: 1px solid var(--border-glass);
        border-radius: 999px;
        background: var(--nav-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow: 0 4px 16px rgba(40, 70, 57, 0.06);
        font-size: 0.8rem;
      }
      .respondent-theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 999px;
        border: 1px solid var(--border-glass);
        background: var(--nav-bg);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        color: var(--text);
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(40, 70, 57, 0.06);
        transition: transform 0.16s ease, background-color 0.16s ease, color 0.16s ease;
      }
      .respondent-theme-toggle:hover {
        transform: scale(1.06);
        color: var(--accent-strong);
      }
      .respondent-theme-toggle .icon-sun {
        display: none;
      }
      .respondent-theme-toggle .icon-moon {
        display: block;
      }
      :global([data-theme="dark"]) .respondent-theme-toggle .icon-sun {
        display: block;
      }
      :global([data-theme="dark"]) .respondent-theme-toggle .icon-moon {
        display: none;
      }
      :global([data-theme="dark"]) .respondent-wm__chip,
      :global([data-theme="dark"]) .respondent-theme-toggle {
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
      }
    </style>
  </body>
</html>
