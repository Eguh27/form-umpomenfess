---
/**
 * BuilderLayout.astro — shell mandiri untuk editor form (T-73).
 * Tanpa header/footer/blob landing: fokus penuh ke kanvas builder.
 * Tema, token, dan font tetap satu keluarga dengan situs utama.
 */
import '../styles/global.css';
import '../components/builder/builder.css';
import themeInitUrl from '../styles/theme-init.js?url&no-inline';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Builder',
  description = 'Susun pertanyaan, atur tampilan, lalu publikasikan form.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FDEEEC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131C1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FDEEEC" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23FDEEEC'/%3E%3Crect x='6' y='5' width='20' height='22' rx='6' fill='%23E8604C'/%3E%3Cpath d='M11 12h10M11 16h10M11 20h6' stroke='%23FFF6EA' stroke-width='2' stroke-linecap='round'/%3E%3C/svg%3E"
    />
    <script is:inline src={themeInitUrl}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&amp;family=Quicksand:wght@400;500;600;700&amp;family=Space+Mono:wght@700&amp;display=swap"
    />
  </head>
  <body class="b-body">
    <a class="skip-link" href="#main">Lompat ke konten</a>
    <main id="main" class="b-main"><slot /></main>
  </body>
</html>
