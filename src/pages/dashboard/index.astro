---
import '../../styles/global.css';
import themeInitUrl from '../../styles/theme-init.js?url&no-inline';
import themeToggleUrl from '../../styles/theme-toggle.js?url&no-inline';
import '../../components/builder/dashboard/dashboard.css';

/*
  Dashboard index (Zona B). Middleware (@A) sudah menahan anonim.
  Layout menggunakan Sidebar Navigation modern ala E-Tutor dengan warna & tema
  Kaca · Blush dari parent web (tokens.css).
*/
import DashboardForms from '../../components/builder/DashboardForms';
import { listForms, type FormRow, type TemplateRow } from '../../components/builder/dashboardForms';

import { isAdmin } from '../../lib/auth/admin';
import { getSupabaseService } from '../../lib/forms/service';
import { countPendingReports } from '../../lib/forms/reports';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');

const userIsAdmin = isAdmin(user);
let pendingReportsCount = 0;
if (userIsAdmin) {
  const service = getSupabaseService();
  if (service) {
    try {
      pendingReportsCount = await countPendingReports(service);
    } catch {
      // Fail-soft: jika tabel belum termigrasi, abaikan
    }
  }
}

// T-64 @B: halaman terautentikasi tidak boleh tersimpan cache (browser / intermediary)
Astro.response.headers.set('cache-control', 'private, no-store');
const supabase = Astro.locals.supabase;

let forms: FormRow[] = [];
let templates: TemplateRow[] = [];
let loadError: string | null = null;

if (supabase) {
  try {
    forms = await listForms(supabase);
    const { data, error } = await supabase
      .from('templates')
      .select('id, name, preview_url, schema')
      .order('name');
    if (error) throw new Error(error.message);
    templates = ((data ?? []) as Array<Record<string, unknown>>)
      .filter((t) => typeof t.schema === 'object' && t.schema !== null)
      .map((t) => ({
        id: String(t.id),
        name: String(t.name),
        title: String(t.name),
        schemaJson: t.schema as Record<string, unknown>,
        previewUrl: (t.preview_url as string | null) ?? null,
      }));
  } catch (e) {
    loadError = e instanceof Error ? e.message : String(e);
  }
} else {
  loadError =
    'Supabase belum dikonfigurasi (env kosong) — dashboard butuh PUBLIC_SUPABASE_URL & PUBLIC_SUPABASE_ANON_KEY.';
}

const displayName = user?.user_metadata?.full_name ?? user?.email ?? 'Pengguna';
const userSummary = {
  email: user.email,
  name: displayName,
  isAdmin: userIsAdmin,
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FDEEEC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131C1A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FDEEEC" />
    <title>Dashboard — umpomenfess form</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%23FDEEEC'/%3E%3Crect x='6' y='5' width='20' height='22' rx='6' fill='%23E8604C'/%3E%3Cpath d='M11 12h10M11 16h10M11 20h6' stroke='%23FFF6EA' stroke-width='2' stroke-linecap='round'/%3E%3Ccircle cx='26' cy='6' r='3' fill='%23F6C96B'/%3E%3C/svg%3E"
    />
    <script is:inline src={themeInitUrl}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&amp;family=Quicksand:wght@400;500;600;700&amp;family=Space+Mono:wght@700&amp;display=swap"
    />
  </head>
  <body>
    {loadError ? (
      <div style="padding: 32px; max-width: 600px; margin: 40px auto; background: var(--surface); border: 1.5px solid var(--danger); border-radius: 16px;">
        <h2 style="color: var(--danger); margin-bottom: 8px;">Galat Memuat Dashboard</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem;">{loadError}</p>
        <a href="/login" class="btn btn--accent btn--sm" style="margin-top: 16px;">Kembali ke Login</a>
      </div>
    ) : (
      <DashboardForms
        client:load
        initialForms={forms}
        templates={templates}
        user={userSummary}
        pendingReportsCount={pendingReportsCount}
      />
    )}
    <script is:inline src={themeToggleUrl}></script>
  </body>
</html>
