---
import Base from '../../../layouts/Base.astro';

/*
  T-52 @C — halaman terima kasih. Ambil judul dari view bila masih ada
  (biar personal); kalau tidak, tampilkan generik.
*/
const slug = Astro.params.slug ?? '';
const supabase = Astro.locals.supabase;
let title: string | null = null;
if (supabase !== null && /^[a-z0-9-]{1,80}$/.test(slug)) {
  const { data } = await supabase
    .from('public_forms')
    .select('title')
    .eq('slug', slug)
    .maybeSingle();
  title = data !== null ? String((data as { title: unknown }).title) : null;
}
---
<Base title="Terima kasih! — umpomenfess form">
  <section class="container" style="padding-block:var(--space-8);max-width:640px;text-align:center">
    <p class="eyebrow">Tercatat</p>
    <h1 style="font-size:clamp(1.8rem,7vw,2.6rem);margin:var(--space-3) 0">Terima kasih!</h1>
    <p style="color:var(--text-muted)">
      Jawabanmu
      {title !== null && <> untuk <strong style="color:var(--text)">{title}</strong></>}
      sudah tersimpan anonim. Tidak ada yang bisa menautkannya balik ke dirimu.
    </p>
    <div style="display:flex;gap:var(--space-3);justify-content:center;margin-top:var(--space-5);flex-wrap:wrap">
      <a class="btn btn--ghost" href="https://umpomenfess.my.id">UMPOmenfess ↗</a>
      <a class="btn btn--ghost" href={`https://umpomenfess.my.id?f=${slug}`}>Lihat fess lain ↗</a>
    </div>
  </section>
</Base>
