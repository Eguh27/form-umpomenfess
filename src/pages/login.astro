  .auth-primary-btn {
    width: 100%;
    margin-top: 3px;
    padding: 10.5px 16px;
    border-radius: 12px;
    background: var(--brand, #2f7263);
    color: var(--on-brand, #fff6ea);
    font-size: 0.88rem;
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 3px 10px rgba(31, 77, 70, 0.2);
  }
  .auth-primary-btn:hover:not(:disabled) {
    background: var(--brand-strong, #245c50);
    transform: translateY(-1px);
    box-shadow: 0 5px 14px rgba(31, 77, 70, 0.3);
  }
  :global([data-theme="dark"]) .auth-primary-btn {
    background: linear-gradient(135deg, var(--brand), var(--brand-strong));
    color: var(--on-brand);
    box-shadow: 0 10px 24px rgba(22, 34, 31, 0.45);
  }
  :global([data-theme="dark"]) .auth-primary-btn:hover:not(:disabled) {
    background: linear-gradient(135deg, var(--brand-strong), var(--brand));
  }
  .auth-primary-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

